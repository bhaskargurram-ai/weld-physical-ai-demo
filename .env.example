# =============================================================================
#  WeldWorld — one-command Runpod run
#
#    cp .env.example .env        # then fill in the 3 keys below
#    python3 runpod/launch.py    # or: make cloud-run
#
#  launch.py (runs on your laptop, Python 3.9+, no extra packages):
#    1. creates (or reuses) a Runpod network volume  -> persistent storage at /workspace
#    2. creates a GPU pod (container) in the same data center, with these values as env vars
#    3. the pod clones this repo, installs everything, runs the full pipeline
#       (simulate -> Mosaico -> Cosmos Curator -> Cosmos 3 -> warm cache), streams logs to you
#    4. when the code ends (or fails, or MAX_HOURS passes, or you press Ctrl-C) the pod is
#       TERMINATED; the volume is kept (models + results) unless DELETE_VOLUME_AT_END=1
#
#  .env is gitignored. Never commit it.
# =============================================================================

# ----------------------------------------------------------------- REQUIRED keys
RUNPOD_API_KEY=                 # https://www.runpod.io/console/user/settings -> API Keys (read/write)
                                # stays on your laptop: it is NOT sent to the pod (Runpod gives the pod
                                # its own pod-scoped key, which the pod uses to shut itself down)
HF_TOKEN=                       # https://huggingface.co/settings/tokens (read) — Cosmos 3 / Curator weights
ANTHROPIC_API_KEY=              # https://console.anthropic.com -> API Keys — Claude as the copilot chat LLM
                                # (leave empty to use the Cosmos 3 Reasoner / scripted chat instead)

# ----------------------------------------------------------------- repo access (private repo)
GITHUB_TOKEN=                   # fine-grained PAT, "Contents: Read-only" on weld-physical-ai-demo only.
                                # needed because the repo is private; leave empty if you make it public
REPO_URL=https://github.com/bhaskargurram-ai/weld-physical-ai-demo
REPO_REF=main                   # branch / tag / commit the pod checks out

# ----------------------------------------------------------------- what to run
RUN_MODE=job                    # job   = full pipeline + warm the Cosmos cache, then shut everything down
                                # serve = job + keep the Weld Copilot online for SERVE_HOURS (the meeting),
                                #         then shut down. URL: https://<pod-id>-7860.proxy.runpod.net
SERVE_HOURS=2                   # serve mode only
MAX_HOURS=6                     # hard safety cap: the pod terminates itself after this, no matter what
N_PASSES=24                     # simulated weld passes
CURATE_BACKEND=curator-next     # curator-next (real Cosmos Curator) | lite (CPU fallback, always works)
COSMOS_GEN_PRESET=live          # live (832x480, fast) | showcase (1280x720, minutes per clip)
COPILOT_LLM=                    # empty = claude if ANTHROPIC_API_KEY set, else scripted | claude | cosmos | scripted

# ----------------------------------------------------------------- Runpod hardware
GPU_TYPE="NVIDIA H100 80GB HBM3"  # tried in order if comma-separated, e.g.
                                    # "NVIDIA H100 80GB HBM3,NVIDIA H100 NVL,NVIDIA H100 PCIe,NVIDIA A100-SXM4-80GB"
GPU_COUNT=2                     # 2 = Reasoner + Generator on separate GPUs (recommended); 1 = budget mode
CLOUD=SECURE                    # SECURE (needed for network volumes) | COMMUNITY
MIN_CUDA_VERSION=13.0           # Cosmos Curator needs a CUDA 13 host driver; use 12.8 + CURATE_BACKEND=lite
                                # if no CUDA 13 hosts are available
IMAGE=runpod/pytorch:2.1.0-cu1300-torch2130-ubuntu2404
CONTAINER_DISK_GB=80            # scratch disk (wiped on terminate); persistent data lives on the volume

# ----------------------------------------------------------------- Runpod storage (network volume)
VOLUME_NAME=weldworld
VOLUME_SIZE_GB=300              # models (~120 GB) + venvs + data. $0.07/GB/month while it exists
DATA_CENTER=                    # empty = pick the data center with the best GPU_TYPE availability
                                # (only used when the volume is first created; the pod follows the volume)
DELETE_VOLUME_AT_END=0          # 1 = also delete the volume when the run ends (next run re-downloads ~1 h)

# ----------------------------------------------------------------- optional
NVIDIA_API_KEY=                 # build.nvidia.com hosted Cosmos 3 fallback (nim backend)
POD_NAME=weldworld
