# WeldWorld demo configuration.
# Copy to `.env` (repo root) or `/workspace/.weldworld/demo.env` on RunPod and edit.
# Every variable has a working default; the file only needs secrets for GPU / cloud features.
#   cp configs/demo.env.example .env

# ----------------------------------------------------------------- data
DATA_DIR=./data                     # generated/, export/, curated/, cache/ live here
N_PASSES=24                         # passes the WeldCell simulator generates (M1 = 24)
SIM_SEED=7                          # deterministic demo data

# ----------------------------------------------------------------- Mosaico (mosaicod, Arrow Flight / gRPC)
MOSAICO_HOST=localhost
MOSAICO_PORT=6726
MOSAICO_OFFLINE=0                   # 1 = read data/generated/ directly, no mosaicod needed

# mosaicod daemon — runpod/start_all.sh only (docker-compose sets its own). bootstrap.sh generates these in
# /workspace/.weldworld/env.sh + secrets.env; uncomment only to override.
# MOSAICOD_DB_URL=postgresql://127.0.0.1:5432/mosaico   # IP, not 'localhost' (static musl build may try ::1)
# MOSAICOD_DB_USER=postgres
# MOSAICOD_DB_PASSWORD=password
# MOSAICOD_STORE_ENDPOINT=file:///workspace/mosaico-store   # or an S3 URL (MinIO)
# MOSAICOD_STORE_BUCKET=mosaico
# MOSAICOD_BIND=0.0.0.0                                   # 127.0.0.1 = reachable only via SSH tunnel
MOSAICOD_LOG_LEVEL=info

# ----------------------------------------------------------------- S3 (MinIO) — Cosmos Curator video-cut reads s3:// only
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=raw
MINIO_ROOT_USER=minioadmin          # RunPod bootstrap generates random creds in /workspace/.weldworld/secrets.env
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin        # same as MINIO_ROOT_USER (boto3 / Curator)
AWS_SECRET_ACCESS_KEY=minioadmin    # same as MINIO_ROOT_PASSWORD
AWS_DEFAULT_REGION=us-east-1

# ----------------------------------------------------------------- curation
CURATE_BACKEND=lite                 # lite | curator-next | curator-legacy
CURATOR_HOME=                       # cosmos-curator checkout with `pixi install` done (RunPod: set by bootstrap)

# ----------------------------------------------------------------- Cosmos 3 world models
COSMOS_BACKEND=auto                 # auto: probe local vLLM servers -> nim if NVIDIA_API_KEY -> replay
                                    # replay (cached, no GPU) | local (vLLM on this pod) | nim (build.nvidia.com)
COSMOS_REASONER_URL=http://localhost:8000/v1
COSMOS_GENERATOR_URL=http://localhost:8001
COSMOS_REASONER_MODEL=nvidia/Cosmos3-Nano
COSMOS_GENERATOR_MODEL=
COSMOS_GEN_PRESET=live              # live (832x480, fast) | showcase (1280x720, minutes per clip)
NVIDIA_API_KEY=                     # optional: nim backend (build.nvidia.com hosted Cosmos 3)

COSMOS_GUARDRAILS=0                 # gated nvidia/Cosmos-1.0-Guardrail; demo runs without (see README)

# GPU layout (runpod/start_all.sh picks these from the GPU count and passes them to worldmodels/serve/*.sh)
# REASONER_GPU=0
# REASONER_GPU_UTIL=0.45            # vLLM --gpu-memory-utilization (0.45 with 2 GPUs, 0.32 on 1 GPU)
# GENERATOR_GPU=1
# GENERATOR_PRECISION=bf16          # bf16 | fp8 (online quantisation) | fp8-ckpt (nvidia/Cosmos3-Nano-FP8)
# OFFLOAD=0                         # 1 = vLLM-Omni --enable-layerwise-offload (single-GPU budget mode)
# COSMOS_HOME=/workspace/cosmos     # vLLM / vLLM-Omni venvs (worldmodels/serve/install.sh)

# ----------------------------------------------------------------- copilot
COPILOT_PORT=7860
COPILOT_LLM=                        # empty = claude if ANTHROPIC_API_KEY is set, else scripted
                                    # claude (tool use) | cosmos (Cosmos3 Reasoner as chat LLM) | scripted (no LLM)
ANTHROPIC_API_KEY=                  # optional
COPILOT_FIXTURES=0                  # 1 = serve the checked-in data/fixtures (no pipeline run needed)

# ----------------------------------------------------------------- Hugging Face (model downloads on RunPod)
HF_TOKEN=                           # read token; Cosmos 3 repos are ungated but a token avoids rate limits
HF_USER=                            # optional, written to the Cosmos Curator config

# ----------------------------------------------------------------- RunPod paths (only used on the pod)
WORKSPACE=/workspace
LOG_DIR=/workspace/logs
